{
  "name": "sysaceite-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "description": "API do SysAceite - controle de O.S. com SLA, Kanban e aprovacao por link",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "env:check": "tsx src/scripts/verificar-env.ts",
    "env:check:dist": "node dist/scripts/verificar-env.js",
    "teste": "node testes/aprovacao.mjs && node testes/anexos.mjs && node testes/equipe.mjs && node testes/grupos.mjs",
    "teste:aprovacao": "node testes/aprovacao.mjs",
    "teste:anexos": "node testes/anexos.mjs",
    "teste:links": "node testes/links.mjs",
    "teste:equipe": "node testes/equipe.mjs",
    "db:limpar-testes": "tsx src/scripts/limpar-testes.ts",
    "teste:grupos": "node testes/grupos.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}

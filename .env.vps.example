# Modelo para a VPS. Copie para api/.env.vps (ou api/.env) e preencha.
#
#   cp .env.vps.example .env.vps
#   chmod 600 .env.vps
#   npm run env:check
#
# A API procura os arquivos a partir da PROPRIA PASTA, nao do diretorio de onde
# voce roda o comando — entao funciona com systemd, pm2, cron ou `node
# /caminho/api/dist/index.js`. Variaveis ja definidas no processo sempre vencem,
# o que permite injetar segredos pelo systemd/Docker sem arquivo nenhum.

NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# Banco
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Gere um novo, nao reaproveite o de desenvolvimento:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Origem do front. Aceita lista separada por virgula (apex + www).
WEB_ORIGIN="https://sysaceite.com.br,https://www.sysaceite.com.br"

# Base do link de aprovacao. Precisa ser a URL PUBLICA — se ficar em localhost,
# os links que voce enviar ao cliente nao abrem.
APP_PUBLIC_URL="https://sysaceite.com.br"

# Bucket. A base e /bucket/api (o snippet do painel mostra /bucket/bucket/api e da 404).
BUCKET_URL="https://99dev.pro/bucket/api"
BUCKET_SLUG="sysaceite"
BUCKET_TOKEN=""
BUCKET_TIMEOUT=30000

# Fallback em disco, usado se BUCKET_URL ou BUCKET_TOKEN ficarem vazios.
# Precisa ser gravavel pelo usuario que roda o processo.
UPLOAD_DIR="/var/lib/sysaceite/uploads"
ANEXO_TAMANHO_MAX=15728640

# E-mail (opcional). Sem provedor, o convite vira link para o admin copiar.
# Escolha UM driver: RESEND_API_KEY (HTTP, sem dependencia) ou SMTP_URL
# (exige `npm i nodemailer`). Com os dois vazios, o envio fica desligado.
EMAIL_REMETENTE="SysAceite <nao-responda@sysaceite.dev>"
RESEND_API_KEY=""
SMTP_URL=""
EMAIL_TIMEOUT=30000

# Teto real do bucket: o nginx dele responde 413 a partir de 1 MB, medido em
# 09/09/2026. Nao adianta subir ANEXO_TAMANHO_MAX sem subir o
# client_max_body_size de la — o efetivo e o menor dos dois.
BUCKET_TAMANHO_MAX=1000000

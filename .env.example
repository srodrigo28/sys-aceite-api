# Banco - string de conexao Postgres (Neon, Supabase, local...)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Auth - gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio"
JWT_EXPIRES_IN="7d"

# CORS - origem do frontend
WEB_ORIGIN="http://localhost:3000"

# URL publica usada para montar o link de aprovacao
APP_PUBLIC_URL="http://localhost:3000"

# Bucket (99dev.pro) - armazenamento de anexos
# ATENCAO: a base e /bucket/api (o snippet do painel mostra /bucket/bucket/api e da 404)
# Deixe BUCKET_URL e BUCKET_TOKEN vazios para gravar em disco (UPLOAD_DIR)
BUCKET_URL="https://99dev.pro/bucket/api"
BUCKET_SLUG="sysaceite"
BUCKET_TOKEN=""
BUCKET_TIMEOUT=30000

# Fallback local
UPLOAD_DIR="./uploads"
ANEXO_TAMANHO_MAX=15728640

# E-mail (opcional). Sem provedor, o convite vira link para o admin copiar.
# Escolha UM driver: RESEND_API_KEY (HTTP, sem dependencia) ou SMTP_URL
# (exige `npm i nodemailer`). Com os dois vazios, o envio fica desligado.
EMAIL_REMETENTE="SysAceite <nao-responda@sysaceite.dev>"
RESEND_API_KEY=""
SMTP_URL=""
EMAIL_TIMEOUT=30000

# Teto real do bucket: o nginx dele responde 413 a partir de 1 MB, medido em
# 09/09/2026. Nao adianta subir ANEXO_TAMANHO_MAX sem subir o
# client_max_body_size de la — o efetivo e o menor dos dois.
BUCKET_TAMANHO_MAX=1000000
